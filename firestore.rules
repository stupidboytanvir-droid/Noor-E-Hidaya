rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && !id.matches('.*/.*');
    }

    function isNonNegInt(val) {
      return val is int && val >= 0;
    }

    function isValidUserProfile(data) {
      return (!('uid' in data) || data.uid == request.auth.uid)
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200))
        && (!('phoneNumber' in data) || data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 40))
        && (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 180000))
        && (!('provider' in data) || (data.provider is string && data.provider.size() <= 32))
        && (!('quranReadMinutes' in data) || isNonNegInt(data.quranReadMinutes))
        && (!('duasReadCount' in data) || isNonNegInt(data.duasReadCount))
        && (!('totalTasbihCount' in data) || isNonNegInt(data.totalTasbihCount))
        && (!('salawatJumatCount' in data) || isNonNegInt(data.salawatJumatCount))
        && (!('hadithReadMinutes' in data) || isNonNegInt(data.hadithReadMinutes))
        && (!('hadithReadCount' in data) || isNonNegInt(data.hadithReadCount))
        && (!('prayerStreak' in data) || isNonNegInt(data.prayerStreak))
        && (!('lastSyncedAt' in data) || isNonNegInt(data.lastSyncedAt))
        && (!('settings' in data) || data.settings is map);
    }

    function isValidCustomZikr(data, zikrId) {
      return data.id is string
        && data.id == zikrId
        && data.id.size() >= 1 && data.id.size() <= 128
        && data.arabicPhrase is string && data.arabicPhrase.size() >= 1 && data.arabicPhrase.size() <= 500
        && (!('transliteration' in data) || (data.transliteration is string && data.transliteration.size() <= 500))
        && (!('bengaliMeaning' in data) || (data.bengaliMeaning is string && data.bengaliMeaning.size() <= 600))
        && data.targetCount is int && data.targetCount >= 1 && data.targetCount <= 100000
        && (!('currentCount' in data) || isNonNegInt(data.currentCount))
        && (!('completedRounds' in data) || isNonNegInt(data.completedRounds))
        && (!('totalHistoricalCount' in data) || isNonNegInt(data.totalHistoricalCount))
        && (!('updatedAt' in data) || isNonNegInt(data.updatedAt));
    }

    // 1. Zero-Trust Default Deny across all collections
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Strict Row-Level Security (RLS) & Schema Validation for Authenticated Users
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming());
      allow delete: if isOwner(userId);

      // Personal Custom Tasbeeh / Dhikr Counters: strict owner + schema validation
      match /customZikrs/{zikrId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(zikrId)
          && isValidCustomZikr(incoming(), zikrId);
        allow delete: if isOwner(userId);
      }

      // Personal Quran Bookmarks: isolated strictly to the owner
      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(bookmarkId);
        allow delete: if isOwner(userId);
      }

      // Personal Favorite Duas: isolated strictly to the owner
      match /favoriteDuas/{duaId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(duaId);
        allow delete: if isOwner(userId);
      }

      // Personal Hadith Bookmarks: isolated strictly to the owner
      match /hadithBookmarks/{hadithId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(hadithId);
        allow delete: if isOwner(userId);
      }

      // Sensitive Debt & Loan Ledger: strict private access
      match /debtLedger/{debtId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(debtId)
          && (!('userId' in incoming()) || incoming().userId == userId);
        allow delete: if isOwner(userId);
      }

      // Daily Amal Records & Habit Streaks: strict private access
      match /amalRecords/{date} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(date);
        allow delete: if isOwner(userId);
      }

      // Monthly Worship Archive & 12-Month Analytics: strict owner + non-negative counter schema
      match /monthlyHistory/{yearMonth} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && yearMonth.matches('^[0-9]{4}-[0-9]{2}$')
          && incoming().yearMonth == yearMonth
          && isNonNegInt(incoming().quranMinutes)
          && isNonNegInt(incoming().duaCount)
          && isNonNegInt(incoming().tasbihCount)
          && isNonNegInt(incoming().duroodCount)
          && isNonNegInt(incoming().hadithMinutes);
        allow delete: if isOwner(userId);
      }
    }
  }
}
