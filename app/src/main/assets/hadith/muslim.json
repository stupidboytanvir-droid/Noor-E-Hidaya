  "hadiths": [
    {
      "hadithNumber": "৮",
      "hadithIndexInBook": 8,
      "chapterNumber": 1,
      "pageNumber": 1,
      "narrator": "হযরত উমর ইবনুল খাত্তাব (রা.) [হাদিসে জিবরীল]",
      "arabicText": "الإِسْلاَمُ أَنْ تَشْهَدَ أَنْ لاَ إِلَهَ إِلاَّ اللَّهُ وَأَنَّ مُحَمَّدًا رَسُولُ اللَّهِ، وَتُقِيمَ الصَّلاَةَ، وَتُؤْتِيَ الزَّكَاةَ، وَتَصُومَ رَمَضَانَ، وَتَحُجَّ الْبَيْتَ إِنِ اسْتَطَعْتَ إِلَيْهِ سَبِيلاً.",
      "banglaText": "ইসলাম হলো এই সাক্ষ্য দেওয়া যে, আল্লাহ ছাড়া কোনো সত্য ইলাহ নেই এবং নিশ্চয়ই মুহাম্মদ ﷺ আল্লাহর রাসূল; সালাত কায়েম করা, যাকাত প্রদান করা, রমাদানের সিয়াম পালন করা এবং সক্ষম হলে আল্লাহর ঘরের হজ্জ সম্পাদন করা।",
      "explanation": "হাদিসে জিবরীল দ্বীনের সামগ্রিক রূপরেখা: ইসলাম, ঈমান ও ইহসান তুলে ধরেছে।",
      "grade": "সহীহ"
    },
    {
      "hadithNumber": "২২৩",
      "hadithIndexInBook": 223,
      "chapterNumber": 2,
      "pageNumber": 96,
      "narrator": "হযরত আবু মালিক আল-আশ'আরী (রা.)",
      "arabicText": "الطُّهُورُ شَطْرُ الإِيمَانِ، وَالْحَمْدُ لِلَّهِ تَمْلأُ الْمِيزَانَ، وَسُبْحَانَ اللَّهِ وَالْحَمْدُ لِلَّهِ تَمْلآنِ - أَوْ تَمْلأُ - مَا بَيْنَ السَّمَاوَاتِ وَالأَرْضِ.",
