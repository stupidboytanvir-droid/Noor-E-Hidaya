  "hadiths": [
    {
      "hadithNumber": "১",
      "hadithIndexInBook": 1,
      "chapterNumber": 1,
      "pageNumber": 1,
      "narrator": "হযরত উমর ইবনুল খাত্তাব (রা.)",
      "arabicText": "إِنَّمَا الأَعْمَالُ بِالنِّيَّاتِ، وَإِنَّمَا لِكُلِّ امْرِئٍ مَا نَوَى، فَمَنْ كَانَتْ هِجْرَتُهُ إِلَى دُنْيَا يُصِيبُهَا أَوْ إِلَى امْرَأَةٍ يَنْكِحُهَا، فَهِجْرَتُهُ إِلَى مَا هَاجَرَ إِلَيْهِ.",
      "banglaText": "যাবতীয় আমল নিয়তের ওপর নির্ভরশীল। প্রত্যেক মানুষ তার নিয়তের ফলই পাবে। সুতরাং যার হিজরত হবে আল্লাহ ও তাঁর রাসূলের সন্তুষ্টির উদ্দেশ্যে, তার হিজরত সে উদ্দেশ্যেই গণ্য হবে। আর যার হিজরত পার্থিব কোনো লাভ কিংবা কোনো নারীকে বিবাহ করার উদ্দেশ্যে হবে, তার হিজরত গণ্য হবে সেই লক্ষ্যেই যে উদ্দেশ্যে সে হিজরত করেছে।",
      "explanation": "হাদিস বিশারদগণের মতে, এই হাদিসটি ইসলামের এক-তৃতীয়াংশ অথবা অর্ধেক দ্বীনের ভিত্তি। অন্তরের শুদ্ধ নিয়ত ব্যতীত কোনো সৎ আমলই কবুল হয় না।",
      "grade": "মুত্তাফাক আলাইহ (সহীহ বুখারী ও মুসলিম)"
    },
    {
      "hadithNumber": "২",
      "hadithIndexInBook": 2,
      "chapterNumber": 1,
      "pageNumber": 1,
      "narrator": "উম্মুল মুমিনীন হযরত আয়েশা (রা.)",
      "arabicText": "أَنَّ الْحَارِثَ بْنَ هِشَامٍ رَضِيَ اللَّهُ عَنْهُ سَأَلَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَالَ: يَا رَسُولَ اللَّهِ كَيْفَ يَأْتِيكَ الْوَحْيُ؟ فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: أَحْيَانًا يَأْتِينِي مِثْلَ صَلْصَلَةِ الْجَرَسِ وَهُوَ أَشَدُّهُ عَلَيَّ فَيَفْصِمُ عَنِّي وَقَدْ وَعَيْتُ عَنْهُ مَا قَالَ، وَأَحْيَانًا يَتَمَثَّلُ لِي الْمَلَكُ رَجُلاً فَيُكَلِّمُنِي فَأَعِي مَا يَقُولُ.",
      "banglaText": "হারিস ইবনে হিশাম (রা.) রাসূলুল্লাহ ﷺ-কে জিজ্ঞাসা করলেন: হে আল্লাহর রাসূল! আপনার নিকট ওহী কীভাবে আসে? রাসূলুল্লাহ ﷺ বললেন: কোনো কোনো সময় তা ঘন্টার ধ্বনির মতো আসে, আর এটি আমার ওপর সবচেয়ে কষ্টদায়ক হয়। অতঃপর ওহী সমাপ্ত হলে যা বলা হয়েছে তা আমি মুখস্থ করে ফেলি। আবার কখনো ফেরেশতা মানুষের আকৃতিতে আমার কাছে আসেন এবং আমার সাথে কথা বলেন, তখন তিনি যা বলেন আমি তা ধারণ করে নিই।",
      "explanation": "ওহী নাযিলের তীব্রতা ও আধ্যাত্মিক গাম্ভীর্যের অনন্য বিবরণ।",
      "grade": "সহীহ"
    },
    {
      "hadithNumber": "৩",
      "hadithIndexInBook": 3,
      "chapterNumber": 1,
      "pageNumber": 2,
      "narrator": "উম্মুল মুমিনীন হযরত আয়েশা (রা.)",
      "arabicText": "أَوَّلُ مَا بُدِئَ بِهِ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنَ الْوَحْيِ الرُّؤْيَا الصَّالِحَةُ فِي النَّوْمِ، فَكَانَ لاَ يَرَى رُؤْيَا إِلاَّ جَاءَتْ مِثْلَ فَلَقِ الصُّبْحِ، ثُمَّ حُبِّبَ إِلَيْهِ الْخَلاَءُ، وَكَانَ يَخْلُو بِغَارِ حِرَاءٍ فَيَتَحَنَّثُ فِيهِ... حَتَّى جَاءَهُ الْحَقُّ وَهُوَ فِي غَارِ حِرَاءٍ، فَجَاءَهُ الْمَلَكُ فَقَالَ: اقْرَأْ، قَالَ: مَا أَنَا بِقَارِئٍ.",
      "banglaText": "রাসূলুল্লাহ ﷺ-এর প্রতি ওহীর সূচনা হয়েছিল নিদ্রাবস্থায় সত্য স্বপ্নের মাধ্যমে। তিনি যে স্বপ্নই দেখতেন, তা প্রত্যুষের আলোর মতো সুস্পষ্ট রূপ লাভ করত। অতঃপর তাঁর কাছে নির্জনতা প্রিয় হয়ে উঠল এবং তিনি হেরা গুহায় নির্জনে অবস্থান করে ইবাদত করতে লাগলেন। অবশেষে হেরা গুহায় তাঁর কাছে সত্য এলো—ফেরেশতা জিবরীল (আ.) এসে বললেন: পড়ুন! তিনি বললেন: আমি পড়তে জানি না...",
      "explanation": "সূরা আলাকের প্রথম পাঁচ আয়াত নাযিলের ঐতিহাসিক পটভূমি।",
      "grade": "সহীহ"
    },
    {
      "hadithNumber": "৯",
      "hadithIndexInBook": 9,
      "chapterNumber": 2,
      "pageNumber": 5,
      "narrator": "হযরত আবু হুরায়রা (রা.)",
      "arabicText": "الإِيمَانُ بِضْعٌ وَسِتُّونَ شُعْبَةً، وَالْحَيَاءُ شُعْبَةٌ مِنَ الإِيمَانِ.",
      "banglaText": "ঈমানের ষাটেরও অধিক শাখা-প্রশাখা রয়েছে। আর লজ্জা বা হায়া হলো ঈমানের অন্যতম প্রধান শাখা।",
      "explanation": "লজ্জাশীলতা মানুষকে পাপাচার থেকে বিরত রাখে এবং সৎকাজে উৎসাহিত করে।",
      "grade": "সহীহ"
    },
    {
      "hadithNumber": "১৩",
      "hadithIndexInBook": 13,
      "chapterNumber": 2,
