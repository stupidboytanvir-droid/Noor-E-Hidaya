<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local database and preferences to protect offline data from unencrypted backup -->
        <exclude domain="database" path="noor_hidayah_database" />
        <exclude domain="sharedpref" path="noor_hidayah_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="noor_hidayah_database" />
        <exclude domain="sharedpref" path="noor_hidayah_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
